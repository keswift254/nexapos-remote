<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Without this, every HTTP call this app makes (the payments
         platform backend, Paystack checkout link) fails outright -
         Android denies network access by default, unlike Windows where
         there's no such per-app permission to grant. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Lets the in-app update feature (see UpdateService) trigger the
         system package installer on a downloaded APK. This is a Play
         Protect "special" permission - declaring it here only makes it
         requestable; the user still has to explicitly flip "Allow from
         this source" for NexaPOS once at the OS level (Settings), which
         open_file's OpenFile.open() surfaces as ResultType.permissionDenied
         if they haven't yet. Irrelevant for Play Store distribution rules
         since this app isn't distributed through Play. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Lets the in-app update's download keep a persistent "Downloading
         update..." notification while it runs, which tells Android to
         treat this app's process as foreground-priority for as long as
         the notification is showing - real field report: this download
         previously ran with no such protection and could be cut off by
         Android's own background app management (or a phone maker's more
         aggressive battery-saving mode) just from switching away from
         NexaPOS mid-download. FOREGROUND_SERVICE_DATA_SYNC and the
         service's declared type are required from Android 14 (API 34)
         onward; POST_NOTIFICATIONS (Android 13/API 33+) only affects
         whether the notification itself is visible - the priority
         protection applies either way. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- allowBackup off: left unset, Android defaults it ON, so Auto Backup
         would copy this app's SQLite file - including its device_meta
         device id and sync cursors - into the owner's Google account and
         restore it onto their next phone. Two phones then claim the same
         device id, which silently corrupts sync attribution (who created
         which row) and the push/pull cursors. A replacement phone should
         re-join the shop with an invite code and sync down instead, which
         the app already supports; Drive backup inside the app is the
         supported way to move data. -->
    <application
        android:label="NexaPOS"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Checkout links resume the existing screen; payment is verified by the app. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nexapos" android:host="checkout-return" />
            </intent-filter>
        </activity>
        <service
            android:name=".DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
